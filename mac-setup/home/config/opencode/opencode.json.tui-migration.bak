{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest"],
  "model": "zai-coding-plan/glm-5",
  "small_model": "zai-coding-plan/glm-4.5-air",
  "provider": {
    "ollama": {
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "glm-5:cloud": {
          "name": "glm-5:cloud"
        },
        "qwen3-coder-next:cloud": {
          "name": "qwen3-coder-next:cloud",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "qwen3.5:cloud": {
          "name": "qwen3.5:cloud"
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "zai-coding-plan": {
      "options": {
        "apiKey": "6d8c5caea4584035ad809858b41840e6.I06tJDX8edbkIurW"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-a119dbd1-599d-4bc1-906c-a02c6dd4d706"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer 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"
      }
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "AQ.Ab8RN6Jl_M_fCyFbCoBPaJPRHCOGCIRLCra-r_JzodkxCvXEWw"
      }
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer 6d8c5caea4584035ad809858b41840e6.I06tJDX8edbkIurW"
      }
    },
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "6d8c5caea4584035ad809858b41840e6.I06tJDX8edbkIurW",
        "Z_AI_MODE": "ZAI"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer 6d8c5caea4584035ad809858b41840e6.I06tJDX8edbkIurW"
      }
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer 6d8c5caea4584035ad809858b41840e6.I06tJDX8edbkIurW"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ]
    },
    "paper": {
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp",
      "enabled": true
    }
  },
  "disabled_providers": [
    "ollama"
  ],
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    },
    "diff_style": "auto"
  }
}
