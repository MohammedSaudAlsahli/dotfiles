# AI Tools Secrets
# Copy this file to secrets.env and fill in your real values.
# secrets.env is gitignored and will NEVER be committed.
#
# After filling this in, run: ./secrets-setup.sh

# --- OpenCode (plain API keys, injected into ~/.config/opencode/opencode.json) ---
OLLAMA_API_KEY="REPLACE_WITH_OLLAMA_API_KEY"
CONTEXT7_API_KEY="REPLACE_WITH_CONTEXT7_API_KEY"
GITHUB_MCP_TOKEN="REPLACE_WITH_GITHUB_TOKEN"
STITCH_API_KEY="REPLACE_WITH_STITCH_API_KEY"

# --- GitHub CLI (token for `gh auth login --with-token`) ---
# Generate at: https://github.com/settings/tokens (scopes: repo, admin:org, gist, workflow)
GITHUB_CLI_TOKEN="REPLACE_WITH_GITHUB_CLI_TOKEN"

# --- OAuth credential files (interactive logins, copy from backup) ---
# Set this to the path of your backup directory containing:
#   codex/auth.json, gemini/gemini-credentials.json, gemini/oauth_creds.json
# Leave empty to skip — you'll need to run interactive logins instead.
OAUTH_BACKUP_DIR=""