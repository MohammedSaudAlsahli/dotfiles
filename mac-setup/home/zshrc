# ===========================================================================
# ZSH Configuration
# ===========================================================================

# --- PATH -----------------------------------------------------------------
path=(
    $HOME/.local/bin
    /opt/homebrew/bin
    $HOME/.n/bin
    $HOME/Library/pnpm/bin
    $HOME/.antigravity-ide/antigravity-ide/bin
    $path
)
export PATH

# --- Environment ----------------------------------------------------------
export HOMEBREW_CASK_OPTS="--no-quarantine"
export NULLCMD=bat
export N_PREFIX=$HOME/.n
export PNPM_HOME=$HOME/Library/pnpm

# Use bat for man pages with clean formatting
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# --- Plugins --------------------------------------------------------------
# Order matters: autosuggestions → autocomplete → syntax-highlighting (last)

# Auto-suggestions: gray ghost text as you type
if [ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"
fi

# Autocomplete: smart menu with case-insensitive matching
if [ -f /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh ]; then
    zstyle ':completion:*' menu yes
    zstyle ':completion:*' selector ' $\u $L2'
    zstyle ':completion:*' list-colors '=(a=magenta fg=cyan, directory=bold/blue)'
    source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh
fi

# Syntax highlighting: green = valid, red = invalid (must be last)
if [ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# --- Prompt ---------------------------------------------------------------
eval "$(starship init zsh)"

# ===========================================================================
# Functions
# ===========================================================================

# Download video/audio from URL (yt-dlp wrapper)
# Usage: ytdlp <url> [username] [password] [output_dir]
ytdlp() {
    local url="$1"
    local username="$2"
    local password="$3"
    local download_path="${4:-$HOME/Downloads/}"
    local cmd="yt-dlp"

    [[ -n "$username" && -n "$password" ]] && cmd+=" -u \"$username\" -p \"$password\""
    cmd+=" \"$url\" -P \"$download_path\""
    eval "$cmd"
}

# Delete everything in current dir except specified file and .git
# Usage: keep <filename>
keep() {
    [[ -z "$1" ]] && echo "Usage: keep <filename>" && return 1
    find . -maxdepth 1 ! -name "$1" ! -name "." ! -name ".git" -exec rm -rf {} +
    echo "Kept: $1 (and .git)"
    ls -a
}

# ===========================================================================
# Aliases
# ===========================================================================

# Navigation
alias ls="lsd -lA --git --header"
alias l="ls -l"
alias la="ls -A"
alias ll="ls -la"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias reload="source ~/.zshrc"
alias trail="<<<${(F)path}"

# Homebrew
alias bod="brew outdated -vg"
alias bu="brew update && brew upgrade"
alias buu="brew update -q && brew upgrade -q -g"

# Development
alias uvv="uv venv .venv"
alias vitejs="pnpm create vite@latest"

# Git
alias gpp="git pull && git push"
alias gs="git status"
alias ga="git add ."
alias gc="git commit -m"
alias gl="git log --oneline --graph --all"

